/**
 * @param {string} s
 * @return {boolean}
 */
var validPalindrome = function(s) {
    let i=0
    let j=s.length-1
    while(i<j){
        let left= s.charAt(i)
        let right=s.charAt(j)
        if (left!==right){
//use superpower
return palindromeHelper(i+1,j,s)|| palindromeHelper(i,j-1,s)
        }
        else{
            i++
            j--
        }
    
    }
    return true
};

var palindromeHelper = function (i,j,s){
   
while(i<j){
       let left= s.charAt(i)
        let right=s.charAt(j)
    if(left===right){
        i++
        j--
    }
    else{
        return false
    }
}
return true
}
