/**
 * @param {number[]} nums
 * @return {number[]}
 */
var sortedSquares = function(nums) {
   let result= new Array(nums.length)
   let i =0
   let j= nums.length-1
   let k= nums.length-1
   while(i<=j){
    if(Math.abs(nums[i])>Math.abs(nums[j])){
result[k]= Math.abs(nums[i])**2
i+=1
    }
    else{
result[k]= Math.abs(nums[j])**2
j-=1
    }
    k-=1
   }
   return result
};
