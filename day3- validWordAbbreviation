class Solution {
    /**
     * @param {string} word
     * @param {string} abbr
     * @return {boolean}
     */
    validWordAbbreviation(word, abbr) {
        let i = 0;
        let j = 0;
        while(i < word.length && j < abbr.length){
            let wordChar = word.charAt(i)
            let abbrChar = abbr.charAt(j)
            if(!isNaN(abbrChar)){
            if(abbrChar==='0'){
                return false
            }
            let current= 0
            while(j<abbr.length && !isNaN(abbr.charAt(j))){
            current=current*10+(abbr.charAt(j)-0)
j++
            }
            i=i+current
            }
            else{
                if(wordChar!==abbrChar){
                    return false
                }
                i++
                j++
            }
        }
            return (i === word.length) && (j === abbr.length)
    }
}
